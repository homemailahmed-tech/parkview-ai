# Hospitality AI — environment variables
# Copy to .env.local (or set in your host's dashboard). NEVER commit real keys — .env* is git-ignored.
# Everything here is read server-side only. Nothing is sent to the browser.

# ===========================================================================
# 1. Language layer — which Meta model to use
# ===========================================================================
# simulation      (default) rule-based stand-in, always labelled "SIMULATION · not Meta AI"
# meta-model-api  Meta's hosted Meta Model API (e.g. Muse Spark 1.3)
# open-weight     a Meta open-weight model (e.g. Muse Spark Open, Llama) on an approved
#                 OpenAI-compatible host: Fireworks, Baseten, Modal, Together, …
# If anything required is missing or invalid, the app stays in simulation and
# shows the reason on the Overview screen (never the key itself).
AI_MODE=simulation

# --- Meta Model API (AI_MODE=meta-model-api) -------------------------------
# Base URL and model below are the defaults from Meta's docs
# (dev.meta.ai/docs/protocols/chat-completions). You normally only need the key.
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_API_MODEL=muse-spark-1.3
# Note: "-contributor" model variants may let Meta train on prompts/completions.
# Do not use them with real guest data.

# --- Open-weight host (AI_MODE=open-weight) --------------------------------
# OpenAI-compatible base URL (the app appends /chat/completions), e.g.
#   Fireworks: https://api.fireworks.ai/inference/v1
#   Together:  https://api.together.xyz/v1
#   Baseten / Modal: your deployment's OpenAI-compatible URL
OPEN_WEIGHT_BASE_URL=
OPEN_WEIGHT_API_KEY=
# The host's exact model id for a Meta open-weight model (Muse Spark Open or Llama).
OPEN_WEIGHT_MODEL=
OPEN_WEIGHT_HOST_LABEL=

# --- Shared safety & tuning -------------------------------------------------
# auto: ask for JSON via response_format and retry once without it if the API rejects it (HTTP 400)
# response_format: always send it | prompt: never send it (JSON enforced by prompt + validation)
AI_JSON_MODE=auto
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=800
# Hard cap on live (billable) model calls per server instance per UTC day.
# Beyond it the app answers in labelled simulation mode.
AI_DAILY_CALL_LIMIT=200
# Exact model ids to accept in addition to the built-in Muse Spark / Llama
# patterns (comma-separated). Non-Meta models are always refused.
AI_EXTRA_ALLOWED_MODELS=
# Set a long random string to enable the owner's "Test live connection" button
# (one small billable call per click). Leave empty to disable.
AI_CONNECTION_TEST_TOKEN=

# ===========================================================================
# 2. Smart Maps — geographic facts & routing
# ===========================================================================
# Default: sample places and no routing. Directions open Google Maps through a
# free, key-less link. Google Places/Routes are BILLABLE and stay disabled
# unless the provider is set to "google" AND billing is approved.
MAPS_PLACES_PROVIDER=sample
MAPS_ROUTING_PROVIDER=none
GOOGLE_MAPS_API_KEY=
# Set to "true" only after the owner has approved Google Maps Platform billing.
GOOGLE_MAPS_BILLING_APPROVED=false
