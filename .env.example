# Hospitality AI — environment variables
# Copy to .env.local and fill in. NEVER commit real keys (.env* is git-ignored).
# All variables are read server-side only; none are exposed to the browser.

# ---------------------------------------------------------------------------
# Meta Llama (language layer)
# ---------------------------------------------------------------------------
# "simulation" (default) = rule-based stand-in, clearly labelled, NOT Meta AI.
# "meta" = call a Meta Llama model through an OpenAI-compatible endpoint.
AI_MODE=simulation

# OpenAI-compatible base URL (the app appends /chat/completions). Examples:
#   Meta Llama API:  https://api.llama.com/compat/v1
#   Fireworks:       https://api.fireworks.ai/inference/v1
#   Together:        https://api.together.xyz/v1
#   Baseten/Modal:   your deployment's OpenAI-compatible URL
META_LLAMA_BASE_URL=
META_LLAMA_API_KEY=
# Must be a Meta Llama model id (non-Llama models are rejected), e.g.
#   Llama-4-Maverick-17B-128E-Instruct-FP8
#   accounts/fireworks/models/llama-v3p3-70b-instruct
META_LLAMA_MODEL=
# Shown in the UI badge, e.g. "Fireworks"
META_LLAMA_HOST_LABEL=

# ---------------------------------------------------------------------------
# Smart Maps (geographic facts & routing)
# ---------------------------------------------------------------------------
# Default: sample places + no routing (directions open in Google Maps via a
# free, key-less link). Google Places/Routes are BILLABLE and stay disabled
# unless BOTH the provider is set to "google" AND billing is approved.
MAPS_PLACES_PROVIDER=sample
MAPS_ROUTING_PROVIDER=none
GOOGLE_MAPS_API_KEY=
# Set to "true" only after the owner has approved Google Maps Platform billing.
GOOGLE_MAPS_BILLING_APPROVED=false
