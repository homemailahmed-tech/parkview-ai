# Hospitality AI — environment variables
# Copy to .env.local (or set in your host's dashboard). NEVER commit real keys — .env* is git-ignored.
# Everything here is read server-side only. Nothing is sent to the browser.

# ===========================================================================
# 0. Access protection (set these on any public deployment)
# ===========================================================================
# Site-wide demo access code: visitors must enter it before anything loads.
# Share it with judges. At least 8 characters. Leave empty for an open site.
DEMO_ACCESS_CODE=
# Owner code: unlocks owner-only controls (approve quotes, record payments,
# AI provider tools). Keep it private; must differ from DEMO_ACCESS_CODE.
# Without it, owner controls are locked on deployed sites.
OWNER_ACCESS_CODE=
# Random string (32+ characters) mixed into session signatures.
SESSION_SECRET=
# true = any visitor may switch to owner role inside their own private browser
# sandbox (useful for judges to try approvals). Default false.
DEMO_PUBLIC_OWNER_MODE=false

# ===========================================================================
# 1. Language layer — which Meta model to use
# ===========================================================================
# simulation      (default) rule-based stand-in, always labelled "SIMULATION · not Meta AI"
# meta-model-api  Meta's hosted Meta Model API (e.g. Muse Spark 1.3) — the hackathon's primary route
# groq            GroqCloud (Meta open-weight model your account can access)
# openrouter      OpenRouter (Meta model; ":free" variants only unless paid use is approved)
# open-weight     any other OpenAI-compatible host: Fireworks, Baseten, Modal, Together, …
# See docs/AI_PROVIDERS.md for what was verified about each provider.
# If anything required is missing or invalid, the app stays in simulation and
# shows the reason on the Overview screen (never the key itself).
AI_MODE=simulation

# Voice dictation uses Meta Muse Voice Transcribe (muse-voice-transcribe-1.0) with the SAME key;
# it is only available with AI_MODE=meta-model-api (never simulated).
# --- Meta Model API (AI_MODE=meta-model-api) -------------------------------
# Base URL and model below are the defaults from Meta's docs
# (dev.meta.ai/docs/protocols/chat-completions). You normally only need the key.
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_API_MODEL=muse-spark-1.3
# Note: "-contributor" model variants may let Meta train on prompts/completions.
# Do not use them with real guest data.

# --- GroqCloud (AI_MODE=groq) — console.groq.com/docs/openai ---------------
# Key from console.groq.com/keys. No default model: Groq's public Llama models
# were deprecated for free/developer tiers in 2026; Muse Spark Open
# ("meta-models/muse-spark-open") is in limited preview needing org approval.
# Use the owner's "List available Meta models" button to see what your key can use.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- OpenRouter (AI_MODE=openrouter) — openrouter.ai/docs/quickstart -------
# Key from openrouter.ai/keys. No default model: check the catalogue first.
# ":free" model ids cost nothing (rate-limited). Paid ids (e.g. meta/muse-spark-open)
# are refused unless OPENROUTER_FREE_ONLY=false — set that only with owner approval.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_ONLY=true
# Optional app attribution headers (not secrets)
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=

# --- Other open-weight host (AI_MODE=open-weight) ---------------------------
# OpenAI-compatible base URL (the app appends /chat/completions), e.g.
#   Fireworks: https://api.fireworks.ai/inference/v1
#   Together:  https://api.together.xyz/v1
#   Baseten / Modal: your deployment's OpenAI-compatible URL
OPEN_WEIGHT_BASE_URL=
OPEN_WEIGHT_API_KEY=
# The host's exact model id for a Meta open-weight model (Muse Spark Open or Llama).
OPEN_WEIGHT_MODEL=
OPEN_WEIGHT_HOST_LABEL=

# --- Shared safety & tuning -------------------------------------------------
# auto: ask for JSON via response_format and retry once without it if the API rejects it (HTTP 400)
# response_format: always send it | prompt: never send it (JSON enforced by prompt + validation)
# "prompt" is the mode verified live with muse-spark-1.3 (1 Nov 2026); response_format is unverified there.
AI_JSON_MODE=prompt
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1
# Muse Spark counts hidden reasoning in the output: a live interpretation used 644 of 800 tokens on reasoning.
# 1200 leaves headroom (worst case about $0.0055 per call at reported prices).
AI_MAX_OUTPUT_TOKENS=1200
# Sent as reasoning_effort to the Meta Model API: minimal (default) | low | medium | high | none (omit the field)
AI_REASONING_EFFORT=minimal
# Hard cap on live (billable) model calls per server instance per UTC day.
# Beyond it the app answers in labelled simulation mode.
AI_DAILY_CALL_LIMIT=200
# Exact Meta model ids to accept in addition to the built-in Muse Spark / Llama
# patterns (comma-separated). Never use this for non-Meta models.
AI_EXTRA_ALLOWED_MODELS=
# Development only: allow a NON-Meta model on groq/openrouter/open-weight. Its output
# is labelled "DEV MODEL · not Meta AI · not hackathon-eligible". Keep false for the demo.
AI_ALLOW_NON_META_DEV_MODEL=false
# Legacy alternative to owner login for the owner tools ("List available Meta
# models", "Test live connection"). Not needed when OWNER_ACCESS_CODE is set.
AI_CONNECTION_TEST_TOKEN=

# ===========================================================================
# 2. Smart Maps — geographic facts & routing
# ===========================================================================
# Default: sample places and no routing. Directions open Google Maps through a
# free, key-less link. Google Places/Routes are BILLABLE and stay disabled
# unless the provider is set to "google" AND billing is approved.
MAPS_PLACES_PROVIDER=sample
MAPS_ROUTING_PROVIDER=none
GOOGLE_MAPS_API_KEY=
# Set to "true" only after the owner has approved Google Maps Platform billing.
GOOGLE_MAPS_BILLING_APPROVED=false
